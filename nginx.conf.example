# Nginx reverse proxy configuration for Loppo custom domain (loppo.com)

server {
    listen 80;
    listen [::]:80;
    server_name loppo.com www.loppo.com;
    return 301 https://loppo.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.loppo.com;

    ssl_certificate /etc/letsencrypt/live/loppo.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/loppo.com/privkey.pem;

    return 301 https://loppo.com$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name loppo.com;

    ssl_certificate /etc/letsencrypt/live/loppo.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/loppo.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Gzip Compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml;
    gzip_min_length 256;

    # Static Asset Caching
    location ~* \.(ico|css|js|gif|jpeg|jpg|png|svg|woff2|webp)$ {
        root /home/zxg-s-server/loppo;
        expires 30d;
        add_header Cache-Control "public, no-transform";
    }

    # Proxy to Node Server
    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
